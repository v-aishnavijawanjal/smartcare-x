# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database
# Leave DATABASE_URL empty to use SQLite in development.
# Set DATABASE_URL for PostgreSQL in production.
DATABASE_URL=

# Mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=SmartCare X <your-email@gmail.com>

# File Uploads
MAX_CONTENT_LENGTH_MB=5
UPLOAD_FOLDER=smartcare/static/uploads

# Pagination
ITEMS_PER_PAGE=10